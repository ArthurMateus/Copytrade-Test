# /etc/copybot.env on the server (chmod 600, owned by root). The same names as the Windows setx variables.
# Lines are NAME=value, no quotes, no spaces around "=".
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
COPYBOT_PIN=
INVO_TOKEN_FILE=/opt/copybot/secrets/invo.token
# live wallet (leave empty to keep it off)
HL_ACCOUNT_ADDRESS=
HL_AGENT_KEY=
# outside check-in (healthchecks.io), optional
HEALTHCHECK_URL=
